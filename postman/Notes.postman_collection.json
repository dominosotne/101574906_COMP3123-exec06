{
  "info": {
    "name": "101574906 COMP3123 Exercise 06",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "noteId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Welcome",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create note",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/notes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": {\n    \"noteTitle\": \"COMP3123 note\",\n    \"noteDescription\": \"Tested through Postman\",\n    \"priority\": \"HIGH\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('noteId', pm.response.json()._id);",
              "pm.test('Title persisted', () => pm.expect(pm.response.json().noteTitle).to.eql('COMP3123 note'));",
              "pm.collectionVariables.set('dateAdded', pm.response.json().dateAdded);"
            ]
          }
        }
      ]
    },
    {
      "name": "List notes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/notes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Contains created note', () => pm.expect(pm.response.json().some(n => n._id === pm.collectionVariables.get('noteId'))).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get note",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/notes/{{noteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Correct note', () => pm.expect(pm.response.json()._id).to.eql(pm.collectionVariables.get('noteId')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update note",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/notes/{{noteId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": {\n    \"noteTitle\": \"COMP3123 note\",\n    \"noteDescription\": \"Tested through Postman\",\n    \"priority\": \"LOW\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Priority updated', () => pm.expect(pm.response.json().priority).to.eql('LOW'));",
              "pm.test('Creation date preserved', () => pm.expect(pm.response.json().dateAdded).to.eql(pm.collectionVariables.get('dateAdded')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify update",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/notes/{{noteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Update persisted', () => pm.expect(pm.response.json().priority).to.eql('LOW'));"
            ]
          }
        }
      ]
    },
